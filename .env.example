# Required for production web and Android builds.
# Local Vite development may use the isolated royal-hires-dev public client.
# Supabase publishable keys are designed for client-side use; never put a service-role/secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
